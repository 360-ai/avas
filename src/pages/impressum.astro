<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Impressum – AVAS Frankenberg</title>
  <meta name="robots" content="noindex, follow">
  <link rel="canonical" href="https://www.avas-frankenberg.de/impressum/">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=DM+Sans:wght@300;400;500;600&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">

  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --red:        #d01010;
      --red-bright: #e62020;
      --yellow:     #f5c800;
      --yellow-dim: #c9a400;
      --black:      #141210;
      --surface:    #1e1c19;
      --surface2:   #282520;
      --border:     rgba(255,255,255,0.09);
      --text:       #f2ede6;
      --text-muted: rgba(242,237,230,0.52);
    }
    html { scroll-behavior: smooth; }
    body {
      background: var(--black);
      color: var(--text);
      font-family: 'DM Sans', sans-serif;
      font-weight: 400;
      line-height: 1.6;
    }

    /* NAV */
    nav {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 48px;
      height: 68px;
      background: var(--surface);
      border-bottom: 1px solid var(--border);
    }
    .nav-logo-img { text-decoration: none; display: flex; align-items: center; }
    .nav-logo-img img { height: 38px; width: auto; }
    .nav-back {
      font-family: 'DM Mono', monospace;
      font-size: 0.72rem;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--text-muted);
      text-decoration: none;
      display: flex;
      align-items: center;
      gap: 8px;
      transition: color 0.2s;
    }
    .nav-back:hover { color: var(--yellow); }

    /* MAIN */
    main {
      max-width: 780px;
      margin: 0 auto;
      padding: 72px 40px 96px;
    }

    .page-eyebrow {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-bottom: 16px;
    }
    .eyebrow-line { width: 28px; height: 2px; background: var(--yellow); }
    .eyebrow-text {
      font-family: 'DM Mono', monospace;
      font-size: 0.7rem;
      letter-spacing: 0.25em;
      text-transform: uppercase;
      color: var(--yellow);
    }

    h1 {
      font-family: 'Bebas Neue', sans-serif;
      font-size: clamp(3rem, 6vw, 5rem);
      line-height: 0.93;
      margin-bottom: 48px;
    }
    h1 em { font-style: normal; color: var(--red); }

    h2 {
      font-family: 'Bebas Neue', sans-serif;
      font-size: 1.6rem;
      letter-spacing: 0.04em;
      margin-top: 48px;
      margin-bottom: 16px;
      color: var(--text);
    }
    h2:first-of-type { margin-top: 0; }

    p {
      font-size: 0.95rem;
      color: var(--text-muted);
      line-height: 1.8;
      margin-bottom: 14px;
    }
    p strong { color: var(--text); font-weight: 600; }
    a { color: var(--red); text-decoration: none; }
    a:hover { color: var(--red-bright); }

    .todo-note {
      background: var(--surface2);
      border-left: 3px solid var(--yellow);
      padding: 12px 16px;
      font-size: 0.82rem;
      color: var(--yellow);
      font-family: 'DM Mono', monospace;
      letter-spacing: 0.06em;
      margin: 8px 0 14px;
      border-radius: 0 2px 2px 0;
    }

    .divider {
      height: 1px;
      background: var(--border);
      margin: 40px 0;
    }

    /* FOOTER */
    footer {
      background: var(--surface);
      border-top: 1px solid var(--border);
      padding: 28px 48px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      flex-wrap: wrap;
    }
    .footer-copy { font-size: 0.75rem; color: var(--text-muted); }
    .footer-links { display: flex; gap: 20px; list-style: none; }
    .footer-links a { font-size: 0.75rem; color: var(--text-muted); text-decoration: none; transition: color 0.2s; }
    .footer-links a:hover { color: var(--yellow); }

    @media (max-width: 640px) {
      nav { padding: 0 20px; }
      main { padding: 48px 20px 72px; }
      footer { padding: 24px 20px; }
    }
  </style>
</head>
<body>

